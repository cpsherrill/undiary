# Copy to .env and fill in. The .env file never gets committed.

# Any long random string in production. The dev default works locally.
SECRET_KEY=

# 1 locally, 0 in production.
DEBUG=1

ALLOWED_HOSTS=localhost,127.0.0.1

# The allowlist: comma-separated emails allowed to sign in.
UNDIARY_ALLOWED_EMAILS=you@example.com

# Of those, the ones that get Django admin at signup.
UNDIARY_ADMIN_EMAILS=you@example.com

# From Google Cloud Console (Google Auth Platform, Clients): an OAuth
# client ID of type Web application. The redirect URI must match the
# host and port you actually run on, exactly, trailing slash included:
#   http://localhost:8990/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Unset means local SQLite. Production points at Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/undiary
